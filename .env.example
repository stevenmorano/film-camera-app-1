# Public configuration for the Expo app. No privileged key belongs here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Optional backend-test override; scripts accept LOCAL databases only.
# Node test scripts use --env-file-if-exists=.env or a PowerShell environment variable.
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
