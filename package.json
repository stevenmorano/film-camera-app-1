{
  "name": "film-camera-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "supabase": "supabase",
    "db:start": "supabase start",
    "db:reset": "supabase db reset --local",
    "test:db": "supabase test db",
    "test:concurrency": "node --env-file-if-exists=.env scripts/test-concurrency.mjs",
    "test:standalone": "node scripts/test-standalone.mjs"
  },
  "dependencies": {
    "expo": "~57.0.26",
    "expo-constants": "~57.0.20",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.24",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "pg": "8.23.1",
    "react-dom": "19.2.3",
    "supabase": "2.119.0",
    "typescript": "~6.0.3"
  }
}
